// Cloudflare Workers: serve the built dashboard (dist/) as static assets.
// An explicit config means `npx wrangler deploy` skips framework auto-setup.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dash",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
